# Environment Variables - SubmissionService

# Server Configuration
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/submission-service

# Logging
LOG_LEVEL=info

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_UI_URL=http://localhost:15672

# External Services
PROBLEM_SERVICE_URL=http://localhost:3001

# Supabase Configuration (for authentication)
# ⚠️ IMPORTANT: Use SERVICE ROLE KEY (not anon key) for backend services
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# the API key through which internal evaluator workers communicate
X_API_KEY=your_api_key
# Environment Variables - ProblemService

# Server Configuration
PORT=3001

# Database
MONGO_URI=mongodb://localhost:27017/problemservice

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS S3 Configuration (for testcase storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_ACCESS_KEY_SECRET=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# Supabase Configuration (for authentication)
# ⚠️ IMPORTANT: Use SERVICE ROLE KEY (not anon key) for backend services
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
